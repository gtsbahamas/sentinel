{
  "name": "shipsafe-sentinel",
  "version": "0.1.5",
  "description": "Security assessment CLI for Next.js + Supabase codebases — the scanner behind ShipSafe coaching",
  "license": "Apache-2.0",
  "author": "Ty Wells (Frank Labs)",
  "homepage": "https://shipsafe-web-eight.vercel.app",
  "type": "module",
  "bin": {
    "shipsafe-sentinel": "./dist/cli.js",
    "sentinel": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc && rm -rf dist/dashboard/client && cp -r src/dashboard/client dist/dashboard/client",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ai-live": "RUN_AI_LIVE_TESTS=1 vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    ".sentinelrc.defaults.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "express": "^5.2.1",
    "fast-glob": "^3.3.2",
    "minimatch": "^10.2.5",
    "open": "^11.0.0",
    "openai": "^6.34.0",
    "pino": "^9.0.0",
    "typescript": "^5.4.0",
    "ws": "^8.20.0",
    "yaml": "^2.4.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.18.1",
    "eslint": "^8.57.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.7.0",
    "vitest": "^1.4.0"
  }
}
